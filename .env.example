# ============================================
# STB Cybersecurity — Environment Variables
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ============================================

# --- Required ---
DATABASE_URL=postgresql://user:password@localhost:5432/stbcs
SESSION_SECRET=          # Generate with: openssl rand -hex 32
CUSTOM_DOMAIN=stbcybersecurity.com
NODE_ENV=production
PORT=5000

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxxxxxxx
RESEND_FROM_EMAIL=noreply@stbcybersecurity.com

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxx

# --- Admin ---
ADMIN_EMAIL=kbpc.inc@gmail.com
ADMIN_STATS_KEY=
INTERNAL_API_KEY=

# --- Threat Intelligence API Keys (Optional) ---
OTX_API_KEY=
VIRUSTOTAL_API_KEY=
HYBRID_ANALYSIS_API_KEY=
GREYNOISE_API_KEY=
CROWDSEC_API_KEY=
SHODAN_API_KEY=
PULSEDIVE_API_KEY=
HONEYDB_API_ID=
HONEYDB_API_KEY=
ABUSEIPDB_API_KEY=
VULNCHECK_API_KEY=

# --- Phone System (Optional) ---
QUO_API_KEY=
QUO_WEBHOOK_SECRET=

# --- Logging ---
LOG_LEVEL=info
